# Database — PostgreSQL from Neon Tech
# Get these URLs from your Neon dashboard: https://console.neon.tech
# Pooled URL (for queries) - better performance with connection pooling
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/DATABASE?sslmode=require&pgbouncer=true&connect_timeout=10"

# Direct URL (for migrations) - required for schema changes
DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/DATABASE?sslmode=require&connect_timeout=10"

# NextAuth
NEXTAUTH_SECRET="your-super-secret-key-here-generate-with-openssl-rand-base64-32"
# NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_URL = "https://ai-sales-generator.vercel.app"

# AI Providers (Fallback System: Gemini → Groq → Demo Mode)
# ============================================================
# Priority 1: Google Gemini (FREE 1,500 requests/day - RECOMMENDED)
# Get your API key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY="your-google-api-key-here"

# Priority 2: Groq (FREE 14,400 requests/day - Fallback)
# Get your API key: https://console.groq.com/keys
GROQ_API_KEY="your-groq-api-key-here"

# Legacy: Anthropic Claude (Expensive - Not recommended for production)
# Only use if you have existing credits
# ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxx"

# Optional: App Config
NEXT_PUBLIC_APP_NAME="SalesForge AI"
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL = "https://ai-sales-generator.vercel.app"
